# generated by MarkRosemaker/devtool — edit files in mk/ instead.
.DEFAULT_GOAL := all
.DELETE_ON_ERROR:
# Bundles rely on their prerequisites running in order, so not with -j.
.NOTPARALLEL:
MAKEFLAGS += --no-print-directory

BINARY := bin/vault$(shell go env GOEXE)
PKG    := ./

CLEAN_FILES := bin cover.out

# remove deletes files and directories: with rm, or with PowerShell on
# Windows, which may have no rm.
ifeq ($(OS),Windows_NT)
empty :=
comma := ,
remove = powershell -NoProfile -Command "Remove-Item -Recurse -Force -ErrorAction SilentlyContinue $(subst $(empty) $(empty),$(comma),$(strip $1)); exit 0"
else
remove = rm -rf $1
endif

# COVER_PKGS is what cover counts: every package but the commands, generators
# and examples beside a library, or all of them where there is nothing else.
# Set with =, so go list runs only for cover.
cover_comma := ,
COVER_PKGS = $(or $(subst $() ,$(cover_comma),$(strip $(foreach p,$(filter-out main:%,$(shell go list -f={{.Name}}:{{.ImportPath}} ./...)),$(word 2,$(subst :, ,$(p)))))),./...)

# A tool built with an older Go than this module targets refuses to analyse it.
TOOL_GO := $(shell go env GOVERSION)
tools: export GOTOOLCHAIN := $(TOOL_GO)

# Where make tools installs, which is GOBIN when that is set. Put on the PATH
# below so an older copy earlier on yours cannot be the one that runs.
TOOL_BIN := $(shell go env GOBIN)
ifeq ($(TOOL_BIN),)
TOOL_BIN := $(shell go env GOPATH)/bin
endif
# A Windows PATH is separated by ;, any other by :, Git Bash's too.
PATH_SEP := $(if $(findstring ;,$(PATH)),;,:)
export PATH := $(TOOL_BIN)$(PATH_SEP)$(PATH)

.PHONY: all ci ready build run smoke lint vet vuln test test-race cover format fix tidy deps generate verify doc tools clean

# ci, plus the checks that need the network.
all: ci vuln

# ready, plus a stop on anything left unregenerated.
ci: ready verify

# After any code change. Needs no network beyond the module cache.
ready: generate fix vet test-race build smoke

build:
	go build -o $(BINARY) $(PKG)

# ARGS passes flags through, e.g. `make run ARGS=-debug`.
run: build
	"$(BINARY)" $(ARGS) | loggo stream --template loggo.template

# Renders the frontend in a browser, failing on any console error or uncaught exception.
smoke:
	cd smoke && node smoke.js

lint:
	golangci-lint run

vet:
	go vet ./...

# Reads the vulnerability database, so it needs the network.
vuln:
	govulncheck ./...

test:
	go test ./...

test-race:
	go test -race ./...

cover:
	go test -coverpkg=$(COVER_PKGS) -coverprofile=cover.out ./...
	go tool cover -func=cover.out

format:
	golangci-lint fmt

fix:
	go fix ./...
	golangci-lint run --fix

tidy:
	go mod tidy
	go mod vendor

deps:
	go get -u ./...
	$(MAKE) tidy

# Everything a tool writes: the files devtool owns, then the go:generate directives, some of which devtool writes.
generate:
	devtool update
	go generate ./...

# For a runner that did not just regenerate: it reports through git, so your own uncommitted edits look like drift.
verify: generate
	git diff --exit-code

# Serves this module's documentation on :8080, as pkg.go.dev will show it.
doc:
	pkgsite .

# Installs what the targets above shell out to, into $(go env GOPATH)/bin and smoke/node_modules.
tools:
	go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest
	go install golang.org/x/vuln/cmd/govulncheck@latest
	go install golang.org/x/pkgsite/cmd/pkgsite@latest
	go install github.com/MarkRosemaker/devtool@latest
	cd smoke && npm install

# A fragment adds its own with CLEAN_FILES += dist.
clean:
	$(call remove,$(CLEAN_FILES))
